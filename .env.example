# ─────────────────────────────────────────────────────────────────────────────
# Swasthya HRMS — Environment Configuration (EXAMPLE ONLY)
# Copy to `.env` and fill in real values. `.env` is gitignored and MUST NOT be
# committed. Rotate any credential that ever lands in git history.
# ─────────────────────────────────────────────────────────────────────────────

# Runtime environment: development | preview | staging | production
NODE_ENV=development

# ── Database ────────────────────────────────────────────────────────────────
# Local dev default matches docker-compose.yml (docker/postgres/init.sql)
DATABASE_URL="postgresql://swasthya_dev:CHANGE_ME_BEFORE_USE@localhost:5432/swasthya_hrms?schema=public&connection_limit=10"

# ── Authentication / Auth.js v5 ─────────────────────────────────────────────
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="REPLACE_WITH_RANDOM_32_BYTE_SECRET"
AUTH_TRUST_HOST=true
# Comma-separated exact origins allowed for auth callbacks
AUTH_ALLOWED_ORIGINS=http://localhost:3000

# Session policy (ADR-003): database-backed sessions
SESSION_MAX_AGE_SECONDS=28800
SESSION_UPDATE_AGE_SECONDS=3600

# ── MFA (Phase 1+; reserved — see ADR-003) ─────────────────────────────────
# TOTP issuer shown in authenticator apps. No MFA enforcement in Phase 0.
MFA_ISSUER=Swasthya%20HRMS
# Enforce TOTP enrollment after N days from first login (0 = disabled Phase 0)
MFA_GRACE_DAYS=0

# ── Rate limiting (per-IP, in-memory Phase 0) ───────────────────────────────
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_GLOBAL_WINDOW_SECONDS=60

# ── Audit (ADR-005) ─────────────────────────────────────────────────────────
# Write failures fail closed: requests are blocked if audit cannot be written
AUDIT_FAIL_CLOSED=true

# ── Seeding (local/dev only) ────────────────────────────────────────────────
# Seed script generates a random admin password and prints it ONCE.
# Do NOT set a static admin password here. If you must bootstrap non-
# interactively, pass it via a secrets manager, never via git-tracked files.
SEED_TENANT_SLUG=swasthya-pilot
SEED_ORG_NAME=Swasthya Pilot Hospital

# ── Feature flags (Phase 0 defaults) ────────────────────────────────────────
FEATURE_MFA=false
FEATURE_HMS_INTEGRATION=false

# ── Observability ───────────────────────────────────────────────────────────
LOG_LEVEL=info
